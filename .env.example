# Where producers publish: "local" (JSONL under data/landing) or "pubsub"
GTDP_SINK=local
GTDP_LANDING_DIR=data/landing

# GCP
GCP_PROJECT=your-gcp-project
BQ_LOCATION=EU
BQ_RAW_DATASET=raw
BQ_OPS_DATASET=ops
# Uncomment to use the Pub/Sub emulator from docker-compose
# PUBSUB_EMULATOR_HOST=localhost:8085

# Deriv public market-data WebSocket (no login needed)
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
DERIV_SYMBOLS=R_10,R_25,R_50,R_75,R_100

# Simulator
SIM_NUM_CLIENTS=50
SIM_TRADE_PROBABILITY=0.3
SIM_SEED=

# Optional: POST alerts to a Slack-compatible webhook
ALERT_WEBHOOK_URL=
